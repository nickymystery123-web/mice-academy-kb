# ============================================
# MICE 会展专业知识库 - 环境变量配置
# 复制此文件为 .env 并填入你的配置
# ============================================

# --- 大模型 API 配置（必填，不填则 AI 问答降级为仅检索）---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- FastGPT 配置（V1 起 AI 问答底座）---
# FastGPT 应用 ID（在 FastGPT 后台「应用 → API 访问」获取）
FASTGPT_APP_ID=
# FastGPT API 密钥（在 FastGPT 后台「账号 → API 密钥」创建）
FASTGPT_APIKEY=

# --- 检索参数（可选，有默认值）---
# VECTOR_TOP_K=20
# BM25_TOP_K=20
# FINAL_TOP_K=5
# RRF_K=60
