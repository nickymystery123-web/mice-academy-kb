# FastGPT 环境变量模板
# 复制为 .env 并填入实际值（.env 已被 gitignore）

POSTGRES_USER=miceadmin
POSTGRES_PASSWORD=你的PG密码
MONGO_INITDB_ROOT_USERNAME=miceadmin
MONGO_INITDB_ROOT_PASSWORD=你的Mongo密码
DEFAULT_ROOT_PSW=FastGPT管理员密码
CHAT_API_KEY=sk-你的DeepSeek或OpenAI兼容APIKey
TOKEN_KEY=任意字符串
ROOT_KEY=任意字符串
FILE_TOKEN_KEY=任意字符串
# 向量模型 API 地址（本地: http://backend:8000/api/v1，Railway: 后端服务 URL）
EMBEDDING_API_URL=http://backend:8000/api/v1