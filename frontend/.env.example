# 前端环境变量模板
# 复制为 .env 并填入实际值（.env 已被 gitignore）

# FastGPT 应用 API Key（在 FastGPT 后台 -> 应用 -> API 访问 中获取）
VITE_FASTGPT_API_KEY=sk-你的FastGPT应用APIKey

# FastGPT 对话 API 地址
# 本地 Docker（nginx 反代）: 留空，使用相对路径 /api/v1/chat/completions
# Railway/云端直连: 填入完整 URL，如 https://mice-fastgpt.up.railway.app/api/v1/chat/completions
VITE_FASTGPT_API_URL=